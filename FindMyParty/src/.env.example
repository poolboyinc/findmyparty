# Copy this file to .env and fill in the values before running docker-compose

# ── Databases (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

IDENTITY_DB_CONNECTION=Host=postgres;Port=5432;Database=fmp_identity;Username=postgres;Password=CHANGE_ME_STRONG_PASSWORD
PARTIES_DB_CONNECTION=Host=postgres;Port=5432;Database=fmp_parties;Username=postgres;Password=CHANGE_ME_STRONG_PASSWORD
BOOKINGS_DB_CONNECTION=Host=postgres;Port=5432;Database=fmp_bookings;Username=postgres;Password=CHANGE_ME_STRONG_PASSWORD

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_KEY=CHANGE_ME_MINIMUM_32_CHARACTERS_LONG
JWT_ISSUER=FindMyParty.Identity
JWT_AUDIENCE=FindMyParty.Mobile

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=fmp_rabbit
RABBITMQ_PASS=CHANGE_ME_RABBIT_PASSWORD
