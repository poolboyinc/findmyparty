# Copy this file to .env and fill in the values before running docker-compose

# ── Databases (RDS SQL Server Express on AWS) ────────────────────────────────
# All 3 databases can be on the same RDS instance
IDENTITY_DB_CONNECTION=Server=<rds-endpoint>;Database=fmp_identity;User Id=sa;Password=<YourStrongPassword>;TrustServerCertificate=True;
PARTIES_DB_CONNECTION=Server=<rds-endpoint>;Database=fmp_parties;User Id=sa;Password=<YourStrongPassword>;TrustServerCertificate=True;
BOOKINGS_DB_CONNECTION=Server=<rds-endpoint>;Database=fmp_bookings;User Id=sa;Password=<YourStrongPassword>;TrustServerCertificate=True;

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_KEY=CHANGE_ME_MINIMUM_32_CHARACTERS_LONG
JWT_ISSUER=FindMyParty.Identity
JWT_AUDIENCE=FindMyParty.Mobile

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=fmp_rabbit
RABBITMQ_PASS=CHANGE_ME_RABBIT_PASSWORD
