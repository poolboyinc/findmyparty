# Google OAuth (iOS)
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_REVERSED_CLIENT_ID=com.googleusercontent.apps.your-client-id

# Mapbox — get a token at https://account.mapbox.com/access-tokens/
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token

# Dev backend host for iOS simulator (your machine's local IP)
EXPO_PUBLIC_DEV_HOST=192.168.x.x
