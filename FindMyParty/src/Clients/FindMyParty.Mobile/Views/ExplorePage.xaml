<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FindMyParty.Mobile.Views.ExplorePage"
             Title="Explore"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0D0D0D">

    <AbsoluteLayout>

        <!-- Full-screen map -->
        <WebView x:Name="mapWebView"
                 Navigating="OnNavigating"
                 AbsoluteLayout.LayoutBounds="0,0,1,1"
                 AbsoluteLayout.LayoutFlags="All" />

        <!-- Loading overlay -->
        <Grid IsVisible="{Binding IsBusy}"
              BackgroundColor="#CC0D0D0D"
              AbsoluteLayout.LayoutBounds="0,0,1,1"
              AbsoluteLayout.LayoutFlags="All">
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="16">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   Color="#7C3AED"
                                   HeightRequest="48"
                                   WidthRequest="48" />
                <Label Text="Finding parties near you..."
                       TextColor="#AAAAAA"
                       FontSize="14"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- Floating date picker bubble -->
        <Border x:Name="dateBubble"
                AbsoluteLayout.LayoutBounds="0.5,1,-1,-1"
                AbsoluteLayout.LayoutFlags="XProportional,YProportional"
                Margin="0,0,0,20"
                BackgroundColor="#7C3AED"
                StrokeShape="RoundRectangle 26"
                Stroke="#BF7CFF"
                StrokeThickness="1.5"
                Padding="20,12">
            <Border.Shadow>
                <Shadow Brush="#7C3AED" Offset="0,0" Radius="24" Opacity="0.85" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDateBubbleTapped" />
            </Border.GestureRecognizers>
            <Label x:Name="dateBubbleLabel"
                   Text="&#128197;  All Dates"
                   TextColor="White"
                   FontSize="14"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center" />
        </Border>

        <!-- Date picker dialog overlay -->
        <Grid x:Name="datePickerOverlay"
              IsVisible="False"
              AbsoluteLayout.LayoutBounds="0,0,1,1"
              AbsoluteLayout.LayoutFlags="All"
              BackgroundColor="#AA000000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCancelDate" />
            </Grid.GestureRecognizers>
            <Border VerticalOptions="Center"
                    HorizontalOptions="Center"
                    WidthRequest="300"
                    BackgroundColor="#1A1A1A"
                    Stroke="#7C3AED"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 20"
                    Padding="28,24">
                <Border.Shadow>
                    <Shadow Brush="#7C3AED" Offset="0,0" Radius="30" Opacity="0.6" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="20">

                    <Label Text="&#128197;  Filter by Date"
                           TextColor="White"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />

                    <BoxView HeightRequest="1"
                             BackgroundColor="#7C3AED"
                             Opacity="0.4" />

                    <DatePicker x:Name="datePicker"
                                TextColor="#BF7CFF"
                                BackgroundColor="#2A2A2A"
                                MinimumDate="01/01/2020"
                                MaximumDate="12/31/2099"
                                HorizontalOptions="Center" />

                    <BoxView HeightRequest="1"
                             BackgroundColor="#7C3AED"
                             Opacity="0.4" />

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">
                        <Button Grid.Column="0"
                                Text="Clear"
                                TextColor="#BF7CFF"
                                BackgroundColor="Transparent"
                                BorderColor="#7C3AED"
                                BorderWidth="1.5"
                                CornerRadius="14"
                                FontAttributes="Bold"
                                Clicked="OnClearDate" />
                        <Button Grid.Column="1"
                                Text="Apply"
                                TextColor="White"
                                BackgroundColor="#7C3AED"
                                CornerRadius="14"
                                FontAttributes="Bold"
                                Clicked="OnApplyDate">
                            <Button.Shadow>
                                <Shadow Brush="#7C3AED" Offset="0,4" Radius="14" Opacity="0.8" />
                            </Button.Shadow>
                        </Button>
                    </Grid>

                </VerticalStackLayout>
            </Border>
        </Grid>

    </AbsoluteLayout>

</ContentPage>
