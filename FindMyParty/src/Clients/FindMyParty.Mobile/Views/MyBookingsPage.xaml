<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FindMyParty.Mobile.Models.Bookings"
             x:Class="FindMyParty.Mobile.Views.MyBookingsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0D0D0D">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Padding="24,56,24,16" Spacing="4">
            <Label Text="My Bookings"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="White" />
            <Label Text="Your upcoming and past parties"
                   FontSize="14"
                   TextColor="#888888" />
        </VerticalStackLayout>

        <!-- Content -->
        <RefreshView Grid.Row="1"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsBusy}"
                     RefreshColor="#7C3AED">

            <Grid>
                <!-- Empty state -->
                <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="12">
                    <Label Text="🎟️"
                           FontSize="56"
                           HorizontalTextAlignment="Center" />
                    <Label Text="No bookings yet"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Find a party on the map and book your spot"
                           FontSize="14"
                           TextColor="#888888"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Bookings list -->
                <CollectionView ItemsSource="{Binding Bookings}"
                                IsVisible="{Binding HasBookings}"
                                Margin="0,0,0,16">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:BookingItem">
                            <Grid Padding="20,0">
                                <Border BackgroundColor="#1A1A1A"
                                        Stroke="#2A2A2A"
                                        StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>

                                    <Grid RowDefinitions="Auto,1,Auto" Padding="18">

                                        <!-- Top row: status badge + date -->
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">

                                            <!-- Status badge -->
                                            <Border Grid.Column="0"
                                                    BackgroundColor="{Binding StatusBackgroundColor}"
                                                    Stroke="{Binding StatusBorderColor}"
                                                    StrokeThickness="1"
                                                    Padding="10,4">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="20" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Status}"
                                                       TextColor="{Binding StatusColor}"
                                                       FontSize="12"
                                                       FontAttributes="Bold" />
                                            </Border>

                                            <!-- Date -->
                                            <Label Grid.Column="2"
                                                   Text="{Binding CreatedAt, StringFormat='{0:MMM d, yyyy}'}"
                                                   TextColor="#666666"
                                                   FontSize="12"
                                                   VerticalOptions="Center" />
                                        </Grid>

                                        <!-- Divider -->
                                        <BoxView Grid.Row="1"
                                                 Color="#2A2A2A"
                                                 HeightRequest="1"
                                                 Margin="0,0,0,12" />

                                        <!-- Bottom row: tickets + price + view button -->
                                        <Grid Grid.Row="2"
                                              ColumnDefinitions="*,*,Auto"
                                              ColumnSpacing="8">

                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="Tickets"
                                                       TextColor="#666666"
                                                       FontSize="11" />
                                                <Label Text="{Binding TicketCount}"
                                                       TextColor="White"
                                                       FontSize="16"
                                                       FontAttributes="Bold" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label Text="Total"
                                                       TextColor="#666666"
                                                       FontSize="11" />
                                                <Label Text="{Binding TotalPrice, StringFormat='€{0:F2}'}"
                                                       TextColor="#A78BFA"
                                                       FontSize="16"
                                                       FontAttributes="Bold" />
                                            </VerticalStackLayout>

                                            <Button Grid.Column="2"
                                                    Text="View Party"
                                                    BackgroundColor="#2A2A2A"
                                                    TextColor="#A78BFA"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    CornerRadius="10"
                                                    Padding="12,8"
                                                    CommandParameter="{Binding PartyId}"
                                                    Clicked="OnViewPartyClicked" />
                                        </Grid>

                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>
            </Grid>
        </RefreshView>

    </Grid>

</ContentPage>
