<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FindMyParty.Mobile.Views.RegisterPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#0D0D0D">

    <ScrollView>
        <VerticalStackLayout Padding="32,60,32,32" Spacing="16" VerticalOptions="Center">

            <!-- Header -->
            <Label Text="🎉"
                   FontSize="52"
                   HorizontalTextAlignment="Center" />

            <Label Text="Create Account"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalTextAlignment="Center" />

            <Label Text="Join the party"
                   FontSize="15"
                   TextColor="#888888"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,24" />

            <!-- Username -->
            <Border Stroke="#2A2A2A"
                    StrokeThickness="1"
                    BackgroundColor="#1A1A1A"
                    HeightRequest="52">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Entry Placeholder="Username"
                       Text="{Binding UserName}"
                       PlaceholderColor="#666666"
                       TextColor="White"
                       ReturnType="Next"
                       Margin="16,0" />
            </Border>

            <!-- Email -->
            <Border Stroke="#2A2A2A"
                    StrokeThickness="1"
                    BackgroundColor="#1A1A1A"
                    HeightRequest="52">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Entry Placeholder="Email"
                       Text="{Binding Email}"
                       PlaceholderColor="#666666"
                       TextColor="White"
                       Keyboard="Email"
                       ReturnType="Next"
                       Margin="16,0" />
            </Border>

            <!-- Password -->
            <Border Stroke="#2A2A2A"
                    StrokeThickness="1"
                    BackgroundColor="#1A1A1A"
                    HeightRequest="52">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Entry Placeholder="Password"
                       Text="{Binding Password}"
                       PlaceholderColor="#666666"
                       TextColor="White"
                       IsPassword="True"
                       ReturnType="Done"
                       Margin="16,0" />
            </Border>

            <!-- Error -->
            <Label Text="{Binding ErrorMessage}"
                   TextColor="#EF4444"
                   FontSize="13"
                   IsVisible="{Binding HasError}"
                   HorizontalTextAlignment="Center" />

            <!-- Register button -->
            <Button Text="Create Account"
                    Command="{Binding RegisterCommand}"
                    BackgroundColor="#7C3AED"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="52"
                    FontAttributes="Bold"
                    FontSize="16"
                    IsEnabled="{Binding IsNotBusy}"
                    Margin="0,8,0,0" />

            <!-- Loading -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#7C3AED"
                               HorizontalOptions="Center" />

            <!-- Login link -->
            <HorizontalStackLayout HorizontalOptions="Center"
                                   Spacing="4"
                                   Margin="0,8,0,0">
                <Label Text="Already have an account?"
                       TextColor="#888888"
                       FontSize="14" />
                <Label Text="Sign In"
                       TextColor="#7C3AED"
                       FontSize="14"
                       FontAttributes="Bold">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToLoginCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
