<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FindMyParty.Mobile.Views.SplashPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid>
        <!-- Background: black (top) fading to purple (bottom) at ~57% mark, matching Figma -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#000000" Offset="0.0" />
                    <GradientStop Color="#000000" Offset="0.57" />
                    <GradientStop Color="#7D08FA" Offset="1.0" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Logo icon: full-width sized, positioned in upper center area (~38% from top) -->
        <Image Source="fmp_logo.png"
               HeightRequest="420"
               WidthRequest="420"
               HorizontalOptions="Center"
               VerticalOptions="Start"
               Margin="0,110,0,0"
               Aspect="AspectFit" />

        <ActivityIndicator IsRunning="True"
                           Color="White"
                           VerticalOptions="End"
                           HorizontalOptions="Center"
                           Margin="0,0,0,64" />
    </Grid>

</ContentPage>
