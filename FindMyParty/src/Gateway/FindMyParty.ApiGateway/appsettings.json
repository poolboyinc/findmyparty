{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "ServiceUrls": {
    "Identity": "http://identity-api:8080",
    "Parties": "http://parties-api:8080",
    "Bookings": "http://bookings-api:8080"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth-route": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "RateLimiterPolicy": "auth"
      },
      "identity-users-route": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        },
        "RateLimiterPolicy": "general"
      },
      "identity-hosts-route": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/hosts/{**catch-all}"
        },
        "RateLimiterPolicy": "general"
      },
      "parties-route": {
        "ClusterId": "parties",
        "Match": {
          "Path": "/api/parties/{**catch-all}"
        },
        "RateLimiterPolicy": "general"
      },
      "bookings-route": {
        "ClusterId": "bookings",
        "Match": {
          "Path": "/api/bookings/{**catch-all}"
        },
        "RateLimiterPolicy": "general"
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "identity/d1": {
            "Address": "http://identity-api:8080"
          }
        }
      },
      "parties": {
        "Destinations": {
          "parties/d1": {
            "Address": "http://parties-api:8080"
          }
        }
      },
      "bookings": {
        "Destinations": {
          "bookings/d1": {
            "Address": "http://bookings-api:8080"
          }
        }
      }
    }
  }
}
