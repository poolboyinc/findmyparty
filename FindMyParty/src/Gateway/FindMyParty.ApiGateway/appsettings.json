{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth-route": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "identity-users-route": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "parties-route": {
        "ClusterId": "parties",
        "Match": {
          "Path": "/api/parties/{**catch-all}"
        }
      },
      "bookings-route": {
        "ClusterId": "bookings",
        "Match": {
          "Path": "/api/bookings/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "identity/d1": {
            "Address": "http://identity-api:8080"
          }
        }
      },
      "parties": {
        "Destinations": {
          "parties/d1": {
            "Address": "http://parties-api:8080"
          }
        }
      },
      "bookings": {
        "Destinations": {
          "bookings/d1": {
            "Address": "http://bookings-api:8080"
          }
        }
      }
    }
  }
}
